# Dependencies
node_modules/
frontend/node_modules/

# Production Build
dist/
frontend/dist/

# Local Environment & Logs
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime Uploads (Persistent across Git deployments)
public/uploads/**
!public/uploads/**/
!public/uploads/**/.gitkeep
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/.gitkeep

# External Persistent Storage
persistent_storage/*
!persistent_storage/.gitkeep

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
